{
  "name": "cfpathcheck",
  "version": "11.4.2",
  "description": "Check CFML files for correct paths in cfinclude/cfimport tags",
  "license": "MIT",
  "repository": "github:timbeadle/cfpathcheck",
  "homepage": "https://github.com/timbeadle/cfpathcheck",
  "bugs": "https://github.com/timbeadle/cfpathcheck/issues",
  "author": "Tim Beadle (https://github.com/timbeadle)",
  "type": "module",
  "exports": {
    "types": "./dist/cfpathcheck.d.ts",
    "default": "./lib/cfpathcheck.js"
  },
  "bin": {
    "cfpathcheck": "./bin/cli.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">= 26.13.0"
  },
  "scripts": {
    "build:types": "rimraf ./dist/* && tsc",
    "test": "run-p test:snyk test:lint test:unit test:engines",
    "test:ci": "run-p test:lint test:unit test:engines",
    "test:engines": "ls-engines",
    "test:coverage": "nyc --reporter=lcov npm run test:unit",
    "test:lint": "xo",
    "test:snyk": "snyk test --dev",
    "test:unit": "mocha test/*.spec.js",
    "snyk-protect": "snyk-protect",
    "prepare": "npm run snyk-protect"
  },
  "files": [
    "bin",
    "dist",
    "lib",
    "test"
  ],
  "keywords": [
    "cli",
    "command line",
    "cfml",
    "static analysis"
  ],
  "dependencies": {
    "@snyk/protect": "^1.1308.3",
    "chalk": "^5.6.2",
    "checkstyle-formatter": "^1.1.0",
    "crlf": "^1.1.1",
    "deep-equal": "^2.2.3",
    "glob": "^14.0.3",
    "log-symbols": "^7.0.1",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/checkstyle-formatter": "^1.0.2",
    "@types/deep-equal": "^1.0.4",
    "@types/minimist": "^1.2.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "chai": "^6.3.0",
    "globals": "^17.13.0",
    "ls-engines": "^0.10.1",
    "mocha": "^12.0.3",
    "npm-run-all2": "^9.0.4",
    "nyc": "^18.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "xo": "^5.0.1"
  },
  "snyk": true,
  "volta": {
    "node": "26.13.0",
    "npm": "12.2.1"
  }
}
